#!/usr/bin/env php
<?php

use Illuminate\Foundation\Application;
use Symfony\Component\Console\Input\ArgvInput;

define('LARAVEL_START', microtime(true));

// The Artisan test command boots Laravel before PHPUnit loads phpunit.xml. Point
// Laravel at the isolated test cache first so a production config cache can
// never leak the active application database into the test process.
if (([1] ?? null) === 'test') {
    $testConfigCache = 'storage/framework/testing/bootstrap/cache/config-'.getmypid().'.php';
    putenv('APP_CONFIG_CACHE='. $testConfigCache);
    $_ENV['APP_CONFIG_CACHE'] = $testConfigCache;
    $_SERVER['APP_CONFIG_CACHE'] = $testConfigCache;
}

// Register the Composer autoloader...
require __DIR__.'/vendor/autoload.php';

// Bootstrap Laravel and handle the command...
/** @var Application $app */
$app = require_once __DIR__.'/bootstrap/app.php';

$status = $app->handleCommand(new ArgvInput);

exit($status);
